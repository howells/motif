{
  "name": "motif",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@howells/motif-cli",
    "eval:routing": "node apps/cli/evals/routing/run.ts",
    "lint": "turbo run lint && howells-workspace-check",
    "lint:fix": "turbo run lint:fix",
    "prepare": "howells-husky",
    "prepush": "pnpm typecheck && pnpm lint",
    "test": "turbo run test",
    "test:fal-canary": "RUN_FAL_CANARY=1 pnpm --filter @howells/motif-sdk test -- tests/fal-canary.test.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@howells/husky": "catalog:",
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css,md,mdx}": "howells-oxfmt --write"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.23.0"
}
