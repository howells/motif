{
  "name": "motif",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@howells/motif-cli",
    "dev:cli": "turbo run dev --filter=@howells/motif-cli",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:fal-canary": "RUN_FAL_CANARY=1 pnpm --filter @howells/motif-sdk test -- tests/fal-canary.test.ts",
    "prepare": "husky",
    "knip": "knip",
    "clean": "turbo clean",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "check:affected": "turbo run build lint typecheck test --affected",
    "boundaries": "boundaries check"
  },
  "devDependencies": {
    "@howells/boundaries": "0.1.6",
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.12.0",
    "lint-staged": "^17.0.2",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.9.9",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,jsx,tsx}": "howells-fix",
    "*.{json,jsonc,md,css}": "howells-oxfmt --write"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@11.5.2"
}
