{
  "name": "@howells/motif-cli",
  "version": "3.0.0",
  "description": "Agent-first fal.ai image generation CLI with structured output, dry runs, history, series, and terminal studio mode.",
  "keywords": [
    "agent-first",
    "ai",
    "cli",
    "fal",
    "fal.ai",
    "image-generation",
    "structured-output"
  ],
  "homepage": "https://github.com/howells/motif",
  "bugs": {
    "url": "https://github.com/howells/motif/issues"
  },
  "license": "MIT",
  "author": "Daniel Howells",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howells/motif.git",
    "directory": "apps/cli"
  },
  "bin": {
    "motif": "./bin/motif"
  },
  "files": [
    "bin",
    "dist",
    "package.json",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "docs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22",
    "dev": "tsx src/index.ts",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@howells/motif-sdk": "workspace:*",
    "chalk": "catalog:",
    "commander": "catalog:",
    "ink": "catalog:",
    "ink-text-input": "catalog:",
    "ora": "catalog:",
    "react": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react-devtools-core": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
