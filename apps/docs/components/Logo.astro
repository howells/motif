---
// The Motif wordmark, in Faculty Glyphic. Importing the face here loads it on
// every page, where theme.css also sets each page's title in it; every other
// heading stays Inter. The font ships as a local file through Fontsource, so
// it is hashed, self-hosted and served under the docs base.
import "@fontsource/faculty-glyphic/latin-400.css";

interface Props {
  logo?: { href?: string; text?: string } | null;
  site: { title: string };
}

const { logo } = Astro.props;
const href = logo?.href ?? "/";
const text = logo?.text ?? "Motif";
---

<a aria-label={`${text} home`} class="docs-wordmark" href={href}>{text}</a>
