---
// The whole trail, as the Paper boards draw it ("Commands / Edit / erase"),
// where Blume's own shows only the parent group. Labels are the sidebar's, so
// a command page ends in its id while its title reads as plain words.
import { withMountedBase } from "blume/components/islands/base-path.ts";
import type { Crumb } from "blume/components/layout/nav-utils.ts";

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

{
  crumbs.length > 1 && (
    <div class="docs-crumbs">
      <nav aria-label="Breadcrumb">
        <ol>
          {crumbs.map((crumb, index) =>
            index === crumbs.length - 1 ? (
              <li aria-current="page">{crumb.label}</li>
            ) : (
              <li>
                {crumb.route === undefined ? (
                  <span>{crumb.label}</span>
                ) : (
                  <a href={withMountedBase(crumb.route)}>{crumb.label}</a>
                )}
              </li>
            )
          )}
        </ol>
      </nav>
    </div>
  )
}
