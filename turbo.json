{
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  },
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env", "**/.env.local"],
  "boundaries": {
    "tags": {
      "type:app": {
        "dependencies": {
          "deny": ["type:app"]
        }
      },
      "type:package": {
        "dependencies": {
          "deny": ["type:app"]
        }
      },
      "type:tooling": {
        "dependencies": {
          "deny": ["type:app"]
        }
      }
    }
  }
}
